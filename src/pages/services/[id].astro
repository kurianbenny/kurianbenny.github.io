---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('services')).map(entry => ({params:{id:entry.id}, props:{entry}})); }
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<Base title={`${entry.data.title} — Kurian Benny`} description={entry.data.description} schema={{"@type":"Service", "@id":new URL(`/services/${entry.id}/#service`,Astro.site).href,name:entry.data.title,description:entry.data.description,provider:{"@id":new URL("/#person",Astro.site).href},url:new URL(`/services/${entry.id}/`,Astro.site).href}}><article class="wrap article section"><a class="text-link" href="/services/">← All services</a><p class="eyebrow article-label">{entry.data.label}</p><h1>{entry.data.title}</h1><p class="page-intro">{entry.data.description}</p><div class="prose"><Content /></div><div class="article-cta"><h2>Let’s discuss your project.</h2><a class="button" href="/contact/">Get in touch ↗</a></div></article></Base>
