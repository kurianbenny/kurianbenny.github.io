---
import Base from '../../layouts/Base.astro';
import TechIcon from '../../components/TechIcon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const title = `${entry.data.title} — Case Study — Kurian Benny`;
const description = entry.data.description;
const canonicalUrl = new URL(`/case-studies/${entry.id}/`, Astro.site).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": canonicalUrl,
  "headline": entry.data.title,
  "description": entry.data.description,
  "author": {
    "@id": new URL("/#person", Astro.site).href
  },
  "publisher": {
    "@id": new URL("/#person", Astro.site).href
  },
  "url": canonicalUrl,
  "datePublished": entry.data.date ? entry.data.date.toISOString() : undefined,
  "inLanguage": "en"
};
---

<Base title={title} description={description} schema={schema}>
  <article class="wrap article section case-study-article">
    <div class="case-study-nav-top">
      <a class="text-link" href="/case-studies/">← All case studies</a>
    </div>

    <header class="case-study-header">
      <p class="eyebrow article-label">
        {entry.data.category}
        {entry.data.clientType && ` / ${entry.data.clientType}`}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="page-intro">{entry.data.description}</p>
    </header>

    <div class="case-study-executive-summary">
      <div class="executive-summary-heading">
        <span class="card-number">{entry.data.number}</span>
        <div>
          <h3>Project Snapshot</h3>
          <p>Key highlights, architecture scope, and measurable outcomes</p>
        </div>
      </div>

      {entry.data.metrics && entry.data.metrics.length > 0 && (
        <div class="case-metrics-grid">
          {entry.data.metrics.map((metric) => (
            <div class="case-metric-box">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </div>
          ))}
        </div>
      )}

      <div class="case-study-summary-grid">
        <div class="case-summary-col">
          <strong>Challenge</strong>
          <p>{entry.data.challenge}</p>
        </div>
        <div class="case-summary-col">
          <strong>Solution</strong>
          <p>{entry.data.solution}</p>
        </div>
        <div class="case-summary-col case-summary-outcome">
          <strong>Outcome</strong>
          <p>{entry.data.outcome}</p>
        </div>
      </div>

      <div class="case-study-stack-line">
        <span class="stack-label">Technologies:</span>
        <div class="tags">
          {entry.data.technologies.map((tech) => (
            <span>
              <TechIcon name={tech} />
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="prose case-study-prose">
      <Content />
    </div>

    <div class="blog-author-cta">
      <div class="blog-author-info">
        <img
          src="/kurian-benny.jpg"
          alt="Kurian Benny"
          class="blog-author-avatar"
          width="80"
          height="80"
        />
        <div>
          <p class="eyebrow">ABOUT THE ARCHITECT &bull; KURIAN BENNY</p>
          <h3>Need senior full-stack or DevOps execution?</h3>
          <p>
            I have twelve years of experience building resilient web applications, modernizing complex legacy stacks across PHP, Python, and Ruby, and automating cloud infrastructure. Whether you need an architecture audit or end-to-end implementation, let's talk.
          </p>
        </div>
      </div>
      <div class="blog-author-actions">
        <a class="button" href="/contact/">Discuss your project <span>↗</span></a>
        <a class="text-link" href="/case-studies/">All case studies <span>←</span></a>
        <a class="text-link" href="/services/">Explore all services <span>→</span></a>
      </div>
    </div>
  </article>
</Base>
