---
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const title = 'Case Studies — Kurian Benny';
const description = 'In-depth case studies and architectural breakdowns: legacy backend modernization, high-throughput SaaS systems, ERPNext automation, and cloud DevOps by Kurian Benny.';
---

<Base title={title} description={description}>
  <section class="wrap section">
    <p class="eyebrow">CASE STUDIES / SELECTED PRACTICAL WORK</p>
    <h1>Real problems.<br /><em>Reliable outcomes.</em></h1>
    <p class="page-intro">
      In-depth technical breakdowns of projects I've engineered—diving into initial bottlenecks, architecture decisions, step-by-step implementation, and measurable business outcomes.
    </p>

    <div class="case-cards-grid">
      {caseStudies.map((item) => (
        <CaseStudyCard caseStudy={item} />
      ))}
    </div>

    <div class="article-cta" style="margin-top: 70px;">
      <p class="eyebrow">READY TO SOLVE YOUR BOTTLENECK?</p>
      <h2>Have a similar challenge in mind?</h2>
      <p class="section-description" style="max-width: 620px; margin-bottom: 25px;">
        Whether you are untangling a legacy backend, launching a data-intensive product, or modernizing production infrastructure, let's discuss a practical approach.
      </p>
      <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
        <a class="button" href="/contact/">Discuss your project <span>↗</span></a>
        <a class="text-link" href="/services/">Explore all services <span>→</span></a>
      </div>
    </div>
  </section>
</Base>
