---
import Base from '../../layouts/Base.astro';
import TechIcon from '../../components/TechIcon.astro';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const title = 'Case Studies — Kurian Benny';
const description = 'In-depth case studies and architectural breakdowns: legacy backend modernization, high-throughput SaaS systems, ERPNext automation, and cloud DevOps by Kurian Benny.';
---

<Base title={title} description={description}>
  <section class="wrap section">
    <p class="eyebrow">CASE STUDIES / SELECTED PRACTICAL WORK</p>
    <h1>Real problems.<br /><em>Reliable outcomes.</em></h1>
    <p class="page-intro">
      In-depth technical breakdowns of projects I've engineered—diving into initial bottlenecks, architecture decisions, step-by-step implementation, and measurable business outcomes.
    </p>

    <div class="case-study-list">
      {caseStudies.map((item) => (
        <article class="case-study-entry">
          <div class="case-study-entry-header">
            <div class="case-study-entry-meta">
              <span class="card-number">{item.data.number}</span>
              <span class="case-category">{item.data.category}</span>
              {item.data.clientType && (
                <span class="case-client-type">/ {item.data.clientType}</span>
              )}
            </div>
            <h2>
              <a href={`/case-studies/${item.id}/`}>{item.data.title}</a>
            </h2>
            <p class="case-study-entry-desc">{item.data.description}</p>
          </div>

          {item.data.metrics && item.data.metrics.length > 0 && (
            <div class="case-metrics-grid">
              {item.data.metrics.map((metric) => (
                <div class="case-metric-box">
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </div>
              ))}
            </div>
          )}

          <div class="case-study-summary-grid">
            <div class="case-summary-col">
              <strong>Challenge</strong>
              <p>{item.data.challenge}</p>
            </div>
            <div class="case-summary-col">
              <strong>Solution</strong>
              <p>{item.data.solution}</p>
            </div>
            <div class="case-summary-col case-summary-outcome">
              <strong>Outcome</strong>
              <p>{item.data.outcome}</p>
            </div>
          </div>

          <div class="case-study-entry-footer">
            <div class="tags">
              {item.data.technologies.map((tech) => (
                <span>
                  <TechIcon name={tech} />
                  {tech}
                </span>
              ))}
            </div>
            <a class="button case-read-button" href={`/case-studies/${item.id}/`}>
              Read case study <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="article-cta" style="margin-top: 70px;">
      <p class="eyebrow">READY TO SOLVE YOUR BOTTLENECK?</p>
      <h2>Have a similar challenge in mind?</h2>
      <p class="section-description" style="max-width: 620px; margin-bottom: 25px;">
        Whether you are untangling a legacy backend, launching a data-intensive product, or modernizing production infrastructure, let's discuss a practical approach.
      </p>
      <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
        <a class="button" href="/contact/">Discuss your project <span>↗</span></a>
        <a class="text-link" href="/services/">Explore all services <span>→</span></a>
      </div>
    </div>
  </section>
</Base>
