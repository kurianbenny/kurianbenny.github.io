---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const caseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft))
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0) || b.data.order - a.data.order);
  return paginate(caseStudies, { pageSize: 2 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'caseStudies'>>;
}

const { page } = Astro.props;
const caseStudies = page.data;

const title = page.currentPage > 1
  ? `Case Studies (Page ${page.currentPage}) — Kurian Benny`
  : 'Case Studies — Kurian Benny';
const description = 'In-depth case studies and architectural breakdowns: legacy backend modernization, high-throughput SaaS systems, ERPNext automation, and cloud DevOps by Kurian Benny.';
---

<Base title={title} description={description}>
  <section class="wrap section">
    <p class="eyebrow">CASE STUDIES / SELECTED PRACTICAL WORK</p>
    <h1>Real problems.<br /><em>Reliable outcomes.</em></h1>
    <p class="page-intro">
      In-depth technical breakdowns of projects I've engineered—diving into initial bottlenecks, architecture decisions, step-by-step implementation, and measurable business outcomes.
    </p>

    {caseStudies.length ? (
      <>
        <div class="case-cards-grid">
          {caseStudies.map((item) => (
            <CaseStudyCard caseStudy={item} />
          ))}
        </div>

        {page.lastPage > 1 && (
          <nav class="pagination" aria-label="Case study pages pagination">
            {page.url.prev ? (
              <a href={page.url.prev} class="pagination-btn" rel="prev">
                <span aria-hidden="true">←</span> Previous
              </a>
            ) : (
              <span class="pagination-btn disabled" aria-disabled="true">
                <span aria-hidden="true">←</span> Previous
              </span>
            )}

            <div class="pagination-pages" aria-label={`Page ${page.currentPage} of ${page.lastPage}`}>
              {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => {
                const href = num === 1 ? '/case-studies/' : `/case-studies/${num}/`;
                const isCurrent = num === page.currentPage;
                return (
                  <a
                    href={href}
                    class={`pagination-number ${isCurrent ? 'active' : ''}`}
                    aria-current={isCurrent ? 'page' : undefined}
                    aria-label={`Page ${num}`}
                  >
                    {num}
                  </a>
                );
              })}
            </div>

            {page.url.next ? (
              <a href={page.url.next} class="pagination-btn" rel="next">
                Next <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="pagination-btn disabled" aria-disabled="true">
                Next <span aria-hidden="true">→</span>
              </span>
            )}
          </nav>
        )}
      </>
    ) : (
      <div class="writing-empty">
        <span aria-hidden="true">[ &nbsp; ]</span>
        <div>
          <h3>Case studies in progress.</h3>
          <p>Detailed architectural writeups are currently being prepared.</p>
          <a class="text-link" href="/">Back to the homepage ↗</a>
        </div>
      </div>
    )}

    <div class="article-cta" style="margin-top: 70px;">
      <p class="eyebrow">READY TO SOLVE YOUR BOTTLENECK?</p>
      <h2>Have a similar challenge in mind?</h2>
      <p class="section-description" style="max-width: 620px; margin-bottom: 25px;">
        Whether you are untangling a legacy backend, launching a data-intensive product, or modernizing production infrastructure, let's discuss a practical approach.
      </p>
      <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
        <a class="button" href="/contact/">Discuss your project <span>↗</span></a>
        <a class="text-link" href="/services/">Explore all services <span>→</span></a>
      </div>
    </div>
  </section>
</Base>
