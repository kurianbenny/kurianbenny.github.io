---
import Base from '../../layouts/Base.astro';
import { contact, emailReady, whatsappReady, whatsappUrl, formesterFormUrl, formesterId } from '../../config/contact';
---
<Base title="Contact — Kurian Benny" description="Discuss a full-stack development, CMS, ERPNext, cloud hosting, or DevOps project with Kurian Benny.">
<section class="wrap section contact-page"><p class="eyebrow">CONTACT / START A CONVERSATION</p><h1>Good things start<br />with{' '}<em>a conversation.</em></h1><p class="page-intro">Tell me what you’re building, where you are today, and what you need help with.</p>
<div class="contact-grid"><div class="contact-details"><h2>Let’s find the next step.</h2><p>A new application, an existing system, or a workflow that could work better. A little context is all we need to start.</p><div class="contact-channel"><p class="eyebrow">EMAIL</p>{emailReady ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : <><span>{contact.email}</span><small>Placeholder · details coming soon</small></>}</div><div class="contact-channel"><p class="eyebrow">WHATSAPP</p><a href={`tel:+${contact.whatsappNumber}`}>+91 94963 68053</a>{!whatsappReady && <small>Placeholder · details coming soon</small>}{whatsappReady ? <a class="button whatsapp-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><img src="/icons/whatsapp.svg" width="24" height="24" alt="" />Connect on WhatsApp ↗</a> : <button class="button whatsapp-button" type="button" disabled>Connect on WhatsApp ↗</button>}</div><div class="profile-social-links"><a class="text-link" href="https://github.com/kurianbenny">You can also find me on GitHub ↗</a><a class="text-link" href="https://www.linkedin.com/in/kurian-benny/">Connect on LinkedIn ↗</a></div></div>
<div class="form-panel" data-clarity-mask="True">
<script src="https://assets.formester.com/widget/standard.js" type="module"></script>
<formester-standard-form
  set-auto-height="false"
  height="820px"
  width="100%"
  id={formesterId}
  url={formesterFormUrl}
></formester-standard-form>
<p class="form-privacy">Enquiries are collected securely through Formester. <a href="/privacy/">Privacy details</a>.</p>
<a class="text-link" href={formesterFormUrl} target="_blank" rel="noopener noreferrer">Open form in a new tab ↗</a>
</div></div></section>
</Base>
