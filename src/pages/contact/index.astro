---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { contact, formReady, whatsappReady, whatsappUrl } from '../../config/contact';
const services = (await getCollection('services')).sort((a,b)=>a.data.order-b.data.order);
---
<Base title="Contact — Kurian Benny" description="Discuss a full-stack development, CMS, ERPNext, cloud hosting, or DevOps project with Kurian Benny.">
<section class="wrap section contact-page"><p class="eyebrow">CONTACT / START A CONVERSATION</p><h1>Good things start<br />with{' '}<em>a conversation.</em></h1><p class="page-intro">Tell me what you’re building, where you are today, and what you need help with.</p>
<div class="contact-grid"><div class="contact-details"><h2>Let’s find the next step.</h2><p>A new application, an existing system, or a workflow that could work better. A little context is all we need to start.</p><div class="contact-channel"><p class="eyebrow">EMAIL</p>{formReady ? <a href={`mailto:${contact.email}`}>{contact.email}</a> : <><span>{contact.email}</span><small>Placeholder · details coming soon</small></>}</div><div class="contact-channel"><p class="eyebrow">WHATSAPP</p><span>+{contact.whatsappNumber}</span>{!whatsappReady && <small>Placeholder · details coming soon</small>}{whatsappReady ? <a class="button whatsapp-button" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Connect on WhatsApp ↗</a> : <button class="button whatsapp-button" type="button" disabled>Connect on WhatsApp ↗</button>}</div><div class="profile-social-links"><a class="text-link" href="https://github.com/kurianbenny">You can also find me on GitHub ↗</a><a class="text-link" href="https://www.linkedin.com/in/kurian-benny/">Connect on LinkedIn ↗</a></div></div>
<form data-clarity-mask="True" class="enquiry-form" id="contact-form" method="POST" action={formReady ? `https://formsubmit.co/${encodeURIComponent(contact.email)}` : undefined} data-ready={String(formReady)}>
<h2>Tell me about your project.</h2><div class="form-pair"><div class="form-field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" placeholder="Your name" /></div><div class="form-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@company.com" /></div></div>
<div class="form-field"><label for="phone">Phone number <span class="optional">(optional)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder="+91 …" /></div>
<div class="form-field"><label for="service">What can I help with? <span class="optional">(optional)</span></label><select id="service" name="service"><option value="">Choose a service</option>{services.map(service=><option value={service.data.title}>{service.data.title}</option>)}<option value="Other">Something else</option></select></div>
<div class="form-field"><label for="message">Your message</label><textarea id="message" name="message" required minlength="1" maxlength="5000" rows="6" placeholder="A little about your project, the challenge, and the outcome you have in mind."></textarea></div>
<input type="hidden" name="_subject" value="New project enquiry — Kurian Benny website" /><input type="hidden" name="_template" value="table" /><input type="hidden" name="_captcha" value="true" /><input type="hidden" name="_next" value={new URL('/contact/thanks/',Astro.site).href} /><input type="text" name="_honey" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
<p class="verification-note">Human verification is handled by FormSubmit before sending your enquiry.</p><button class="button" type="submit" disabled={!formReady}>Send message <span aria-hidden="true">↗</span></button><p class="form-status" id="form-status" role="status">{!formReady && 'This form is a preview. Messages cannot be sent yet.'}</p><p class="form-privacy">When enabled, this form sends your name, email, optional phone number, and message through FormSubmit. <a href="/privacy/">Privacy details</a>.</p>
</form></div></section>
</Base>
<script>
const form = document.querySelector<HTMLFormElement>('#contact-form');
form?.addEventListener('submit', (event) => {
 if (form.dataset.ready !== 'true') { event.preventDefault(); const status=document.querySelector('#form-status'); if(status) status.textContent='This form is a preview. Your message has not been sent.'; }
});
</script>
