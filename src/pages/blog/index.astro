---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Blog — Kurian Benny" description="Development notes and technical perspectives on web applications, backend systems, and software delivery from Kurian Benny."><section class="wrap section"><p class="eyebrow">WRITING / NOTES FROM THE WORKBENCH</p><h1>Thinking out loud.<br /><em>One idea at a time.</em></h1><p class="page-intro">A home for development notes, technical perspectives, and lessons from building.</p>{posts.length ? <div class="post-grid">{posts.map(post=><PostCard post={post} />)}</div> : <div class="writing-empty"><span aria-hidden="true">[ &nbsp; ]</span><div><h3>Good ideas need a little room.</h3><p>The blog is ready. The first articles are still taking shape.</p><a class="text-link" href="/">Back to the homepage ↗</a></div></div>}</section></Base>
