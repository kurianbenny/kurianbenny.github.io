---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(posts, { pageSize: 9 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;
const posts = page.data;

const title = page.currentPage > 1
  ? `Blog (Page ${page.currentPage}) — Kurian Benny`
  : 'Blog — Kurian Benny';
const description = 'Development notes and technical perspectives on web applications, backend systems, and software delivery from Kurian Benny.';
---

<Base title={title} description={description}>
  <section class="wrap section">
    <p class="eyebrow">WRITING / NOTES FROM THE WORKBENCH</p>
    <h1>Thinking out loud.<br /><em>One idea at a time.</em></h1>
    <p class="page-intro">A home for development notes, technical perspectives, and lessons from building.</p>

    {posts.length ? (
      <>
        <div class="post-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>

        {page.lastPage > 1 && (
          <nav class="pagination" aria-label="Blog pages pagination">
            {page.url.prev ? (
              <a href={page.url.prev} class="pagination-btn" rel="prev">
                <span aria-hidden="true">←</span> Previous
              </a>
            ) : (
              <span class="pagination-btn disabled" aria-disabled="true">
                <span aria-hidden="true">←</span> Previous
              </span>
            )}

            <div class="pagination-pages" aria-label={`Page ${page.currentPage} of ${page.lastPage}`}>
              {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => {
                const href = num === 1 ? '/blog/' : `/blog/${num}/`;
                const isCurrent = num === page.currentPage;
                return (
                  <a
                    href={href}
                    class={`pagination-number ${isCurrent ? 'active' : ''}`}
                    aria-current={isCurrent ? 'page' : undefined}
                    aria-label={`Page ${num}`}
                  >
                    {num}
                  </a>
                );
              })}
            </div>

            {page.url.next ? (
              <a href={page.url.next} class="pagination-btn" rel="next">
                Next <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="pagination-btn disabled" aria-disabled="true">
                Next <span aria-hidden="true">→</span>
              </span>
            )}
          </nav>
        )}
      </>
    ) : (
      <div class="writing-empty">
        <span aria-hidden="true">[ &nbsp; ]</span>
        <div>
          <h3>Good ideas need a little room.</h3>
          <p>The blog is ready. The first articles are still taking shape.</p>
          <a class="text-link" href="/">Back to the homepage ↗</a>
        </div>
      </div>
    )}
  </section>
</Base>
