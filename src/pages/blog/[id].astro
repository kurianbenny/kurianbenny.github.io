---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { return (await getCollection('blog',({data})=>!data.draft)).map(entry=>({params:{id:entry.id},props:{entry}})); }
const {entry}=Astro.props;
const {Content}=await render(entry);
---
<Base title={`${entry.data.title} — Kurian Benny`} description={entry.data.description} image={entry.data.image} imageAlt={entry.data.imageAlt} articleDate={entry.data.date.toISOString()} schema={{"@type":"BlogPosting",headline:entry.data.title,description:entry.data.description,datePublished:entry.data.date.toISOString(),author:{"@id":new URL("/#person",Astro.site).href},mainEntityOfPage:new URL(`/blog/${entry.id}/`,Astro.site).href,image:new URL(entry.data.image ?? "/social-card.png",Astro.site).href}}><article class="wrap article section"><a class="text-link" href="/blog/">← All writing</a><p class="eyebrow article-label">{entry.data.category} / <time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en-GB',{timeZone:'UTC',day:'numeric',month:'long',year:'numeric'})}</time></p><h1>{entry.data.title}</h1><p class="page-intro">{entry.data.description}</p>{entry.data.image && <figure class="article-cover"><img src={entry.data.image} srcset={`${entry.data.image.replace('.webp','-480.webp')} 480w, ${entry.data.image.replace('.webp','-960.webp')} 960w, ${entry.data.image} 1280w`} sizes="(max-width: 900px) calc(100vw - 40px), 850px" alt={entry.data.imageAlt} width="1280" height="720" fetchpriority="high" decoding="async" /></figure>}<div class="prose"><Content /></div></article></Base>
