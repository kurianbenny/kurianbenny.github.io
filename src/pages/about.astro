---
import Base from '../layouts/Base.astro';
import TechIcon from '../components/TechIcon.astro';
import { getEntry, render } from 'astro:content';
import { expertise } from '../data/expertise';
const profile=await getEntry('profile','about');
if(!profile) throw new Error('About profile is missing');
const {Content}=await render(profile);
---
<Base title="About — Kurian Benny" description={profile.data.description}>
<section class="wrap page-heading"><p class="eyebrow">ABOUT / THE DEVELOPER BEHIND THE WORK</p><h1>Across the stack.<br /><em>Through to production.</em></h1><p class="page-intro">Twelve years of development experience, with an interest in how the whole application fits together.</p></section>
<section class="wrap profile-layout"><aside class="profile-sidebar"><img src="/kurian-benny.jpg" alt="Kurian Benny" width="800" height="800" /><h2>Kurian Benny</h2><p>Full-stack developer & DevOps</p><div class="profile-fact"><span>Experience</span><strong>12 years</strong></div><div class="profile-fact"><span>Development</span><strong>JavaScript, PHP, Python & Ruby</strong></div><div class="profile-fact"><span>Infrastructure</span><strong>AWS, DigitalOcean & VPS</strong></div><a class="button" href="/contact/">Let’s talk <span>↗</span></a><div class="profile-social-links"><a class="text-link" href="https://github.com/kurianbenny">Explore my GitHub ↗</a><a class="text-link" href="https://www.linkedin.com/in/kurian-benny/">Connect on LinkedIn ↗</a></div></aside><article class="prose profile-story"><Content /></article></section>
<section class="wrap section"><div class="section-heading"><div><p class="eyebrow">TECHNICAL BACKGROUND</p><h2>Across the{' '}<em>stack.</em></h2></div></div><div class="expertise-grid">{expertise.map(item=><div class="expertise-card"><span class="card-number">{item.number}</span><h3>{item.title}</h3><p>{item.description}</p><div class="tags">{item.technologies.map(tech=><span><TechIcon name={tech} />{tech}</span>)}</div></div>)}</div></section>
</Base>
