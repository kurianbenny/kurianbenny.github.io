---
import type { CollectionEntry } from 'astro:content';
import TechIcon from './TechIcon.astro';

interface Props {
  caseStudy: CollectionEntry<'caseStudies'>;
}

const { caseStudy } = Astro.props;
const smallImage = caseStudy.data.image?.replace('.webp', '-480.webp');
const mediumImage = caseStudy.data.image?.replace('.webp', '-960.webp');
---

<a class="case-card" href={`/case-studies/${caseStudy.id}/`}>
  {caseStudy.data.image && (
    <div class="case-card-cover">
      <img
        src={smallImage}
        srcset={`${smallImage} 480w, ${mediumImage} 960w, ${caseStudy.data.image} 1280w`}
        sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 900px) 50vw, 560px"
        alt={caseStudy.data.imageAlt ?? caseStudy.data.title}
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />
      <span class="case-card-badge">{caseStudy.data.category}</span>
    </div>
  )}

  <div class="case-card-body">
    <div class="case-card-meta">
      <span class="card-number">{caseStudy.data.number}</span>
      {caseStudy.data.clientType && (
        <span class="case-client-type">{caseStudy.data.clientType}</span>
      )}
    </div>

    <h3>{caseStudy.data.title}</h3>
    <p class="case-card-desc">{caseStudy.data.description}</p>

    {caseStudy.data.metrics && caseStudy.data.metrics.length > 0 && (
      <div class="case-card-metrics">
        {caseStudy.data.metrics.slice(0, 3).map((metric) => (
          <div class="case-card-metric">
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </div>
        ))}
      </div>
    )}

    <div class="case-card-footer">
      <div class="tags">
        {caseStudy.data.technologies.slice(0, 4).map((tech) => (
          <span>
            <TechIcon name={tech} />
            {tech}
          </span>
        ))}
        {caseStudy.data.technologies.length > 4 && (
          <span class="tag-more">+{caseStudy.data.technologies.length - 4}</span>
        )}
      </div>
      <span class="text-link case-card-link">
        Read case study <span aria-hidden="true">↗</span>
      </span>
    </div>
  </div>
</a>
