---
import '../styles/global.css';
import { whatsappReady, whatsappUrl } from '../config/contact';
interface Props { title?: string; description?: string; schema?: Record<string, unknown>; noindex?: boolean; articleDate?: string; image?: string; imageAlt?: string; }
const { title = 'Kurian Benny — Full-stack Developer & DevOps', description = 'Full-stack developer with twelve years of experience across React, Next.js, Laravel, Django Ninja, FastAPI, Ruby on Rails, AWS, DigitalOcean, and DevOps.' , schema, noindex = false, articleDate, image = "/social-card.png", imageAlt = "Kurian Benny — Software with perspective." } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const structuredData = { '@context': 'https://schema.org', '@graph': [
 { '@type': 'Person', '@id': personId, name: 'Kurian Benny', url: Astro.site?.href, jobTitle: 'Full-stack Developer & DevOps', sameAs: ['https://github.com/kurianbenny', 'https://www.linkedin.com/in/kurian-benny/'], knowsAbout: ['JavaScript', 'React', 'Next.js', 'PHP', 'Laravel', 'Symfony', 'CodeIgniter', 'Yii', 'CakePHP', 'WordPress', 'Drupal', 'Python', 'Django Ninja', 'FastAPI', 'Ruby on Rails', 'ERPNext', 'MySQL', 'NoSQL', 'AWS', 'DigitalOcean', 'VPS hosting', 'Server management', 'DevOps'], image: new URL('/kurian-benny.jpg',Astro.site).href, description: 'Full-stack developer with twelve years of experience across application development, cloud infrastructure, and DevOps.' },
 { '@type': 'WebSite', '@id': websiteId, name: 'Kurian Benny', url: Astro.site?.href, publisher: {'@id': personId}, inLanguage: 'en' },
 { '@type': 'WebPage', '@id': canonical, url: canonical, name: title, description, isPartOf: {'@id':websiteId}, about: {'@id':personId}, inLanguage:'en' },
 ...(schema ? [schema] : [])
] };
const navigation = [{name:'About',href:'/about/'}, {name:'Services',href:'/services/'}, {name:'Blog',href:'/blog/'}, {name:'FAQ',href:'/faq/'}, {name:'Contact',href:'/contact/'}];
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#faf9f6" /><title>{title}</title><link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content={articleDate ? "article" : "website"} /><meta property="og:url" content={canonical} /><meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} /><meta property="og:site_name" content="Kurian Benny" /><meta property="og:locale" content="en_US" /><meta property="og:image" content={new URL(image, Astro.site)} /><meta property="og:image:width" content={image === "/social-card.png" ? "1200" : "1280"} /><meta property="og:image:height" content={image === "/social-card.png" ? "630" : "720"} /><meta property="og:image:alt" content={imageAlt} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={new URL(image, Astro.site)} />{articleDate && <meta property="article:published_time" content={articleDate} />}<link rel="alternate" type="application/rss+xml" title="Kurian Benny — Writing" href="/rss.xml" /><script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
<script is:inline>
    // Keep local previews and other hosts out of production analytics.
    if (window.location.origin === "https://kurianbenny.github.io") {
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "yxlkv78ov4");
    }
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header wrap"><a class="brand" href="/" aria-label="Kurian Benny home"><span class="brand-monogram">kb.</span><span class="brand-wordmark">Kurian Benny<small>FULL-STACK & DEVOPS</small></span></a><button class="menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" hidden>Menu <span aria-hidden="true">☰</span></button><nav id="site-navigation" aria-label="Main navigation">{navigation.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.name}</a>)}</nav><a class="header-contact" href="/contact/">Let’s talk <span aria-hidden="true">↗</span></a></header>
<main id="main"><slot /></main>
<footer class="site-footer"><div class="wrap footer-main"><div class="footer-profile"><a href="/" class="footer-title">Kurian Benny<span>.</span></a><p>Full-stack developer with twelve years of experience.<br />Web applications. Cloud infrastructure. DevOps.</p><a class="text-link" href="https://github.com/kurianbenny">Find me on GitHub ↗</a></div><div class="footer-links"><p class="eyebrow">EXPLORE</p><a href="/about/">About me</a><a href="/services/">Services</a><a href="/blog/">Blog</a></div><div class="footer-links"><p class="eyebrow">CONNECT</p><a href="https://www.linkedin.com/in/kurian-benny/">LinkedIn ↗</a><a href="/contact/">Contact</a><a href="/faq/">FAQ</a><a href="/rss.xml">RSS feed</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Kurian Benny</span><span>Built with care. Kept simple.</span><a href="/privacy/">Privacy</a></div></footer>
{whatsappReady && <a class="whatsapp-float" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Chat with Kurian Benny on WhatsApp"><span class="whatsapp-float-icon" aria-hidden="true"><img src="/icons/whatsapp-white.svg" width="24" height="24" alt="" /></span><span class="whatsapp-float-copy"><strong>Let’s talk</strong></span></a>}
<script>
const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
const nav=document.querySelector<HTMLElement>('#site-navigation');
if(toggle && nav){
 document.documentElement.classList.add('navigation-enhanced');toggle.hidden=false;
 const closeMenu=()=>{toggle.setAttribute('aria-expanded','false');nav.classList.remove('is-open');};
 toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav.classList.toggle('is-open',open);});
 nav.addEventListener('click',event=>{if((event.target as HTMLElement).closest('a')) closeMenu();});
 document.addEventListener('keydown',event=>{if(event.key==='Escape' && toggle.getAttribute('aria-expanded')==='true'){closeMenu();toggle.focus();}});
}
document.addEventListener('click', (event) => {
 const anchor = (event.target as HTMLElement).closest('a');
 if (!anchor) return;
 const href = anchor.getAttribute('href') || '';
 const clarity = (window as any).clarity;
 if (typeof clarity === 'function') {
  if (href.includes('wa.me')) {
   clarity('event', 'whatsapp_click');
  } else if (href.startsWith('mailto:')) {
   clarity('event', 'email_click');
  } else if (href === '/contact/' || href.startsWith('/contact/')) {
   clarity('event', 'contact_cta_click');
  }
 }
});
</script></body></html>
